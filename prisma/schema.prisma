generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // runtime (μπορεί να είναι pooler)
  directUrl = env("DIRECT_URL") // ΠΑΝΤΑ direct για migrations
}

model Checkout {
  id               String         @id @default(cuid())
  shop             String
  checkoutId       String
  token            String?
  email            String?
  phone            String?
  value            Float
  currency         String
  status           CheckoutStatus @default(OPEN)
  abandonedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  raw              String?
  customerName     String?
  itemsJson        String?
  recoveredAt      DateTime?
  recoveredOrderId String?
  recoveredAmount  Float?

  @@unique([shop, checkoutId], name: "shop_checkoutId")
  @@index([shop, status, createdAt])
  @@index([shop, checkoutId, updatedAt])
}

model Order {
  id            String   @id @default(cuid())
  shop          String
  orderId       String
  checkoutId    String?
  checkoutToken String?
  total         Float?
  currency      String?
  financial     String?
  createdAt     DateTime @default(now())
  raw           String?

  @@unique([shop, orderId], name: "shop_orderId")
  @@index([shop, createdAt])
  @@index([shop, checkoutId, createdAt])
  @@index([shop, checkoutToken, createdAt])
}

model CallJob {
  id                String        @id @default(cuid())
  shop              String
  checkoutId        String
  phone             String
  scheduledFor      DateTime
  status            CallJobStatus @default(QUEUED)
  attempts          Int           @default(0)
  provider          String?
  providerCallId    String?
  outcome           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  endedReason       String?
  transcript        String?
  recordingUrl      String?
  sentiment         String?
  tagsCsv           String?
  reason            String?
  nextAction        String?
  followUp          String?
  analysisJson      String?
  attributedAt      DateTime?
  attributedOrderId String?
  attributedAmount  Float?

  @@index([shop, status, scheduledFor])
  @@index([shop, checkoutId])
  @@index([shop, providerCallId])
  @@index([shop, checkoutId, createdAt])
}

model Settings {
  id   String @id @default(cuid())
  shop String @unique

  enabled         Boolean @default(false)
  delayMinutes    Int     @default(30)
  maxAttempts     Int     @default(3)
  retryMinutes    Int     @default(30)
  callLanguage    String  @default("auto")
  callVoice       String  @default("default")
  minOrderValue   Float   @default(0)
  currency        String  @default("USD")
  callWindowStart String  @default("09:00")
  callWindowEnd   String  @default("19:00")

  vapiAssistantId   String?
  vapiPhoneNumberId String?

  userPrompt     String     @default("")
  promptMode     PromptMode @default(append)
  merchantPrompt String     @default("")

  tone                   String @default("neutral")
  goal                   String @default("complete_checkout")
  max_call_seconds       Int    @default(120)
  max_followup_questions Int    @default(2)

  discount_enabled            Boolean @default(false)
  max_discount_percent        Int     @default(10)
  offer_rule                  String  @default("ask_only")
  min_cart_value_for_discount Float?
  coupon_prefix               String?
  coupon_validity_hours       Int     @default(24)
  free_shipping_enabled       Boolean @default(false)

  followup_email_enabled Boolean @default(true)
  followup_sms_enabled   Boolean @default(true)

  sms_template_offer    String?
  sms_template_no_offer String?

  smsSender String? @map("brevoSmsSender") @db.VarChar(32)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

enum BillingPlan {
  FREE
  STARTER
  PRO
  SCALE
  PAYG
}

enum BillingStatus {
  NONE
  PENDING
  ACTIVE
  CANCELLED
}

model ShopBilling {
  shop                String        @id
  plan                BillingPlan   @default(FREE)
  status              BillingStatus @default(NONE)
  currencyCode        String        @default("EUR")
  subscriptionId      String?
  usageLineItemId     String?
  recurringLineItemId String?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  includedSecondsUsed Int           @default(0)
  freeSecondsUsed     Int           @default(0)
  pendingPlan         BillingPlan?
  pendingCouponCode   String?
  pendingCouponId     String?       @db.Uuid
  appliedCouponCode   String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  extraAttempts Int @default(0)
  purchases AttemptPurchase[]
  charges CallCharge[]
}

model CallCharge {
  id               String   @id @default(cuid())
  shop             String
  callJobId        String   @unique
  connectedSeconds Int
  attemptSource    String @default("LEGACY")
  attemptPeriodEnd DateTime?
  minutesBilled    Int
  amountCents      Int
  currencyCode     String
  usageRecordId    String?
  idempotencyKey   String   @unique
  createdAt        DateTime @default(now())

  billing ShopBilling @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@index([shop, createdAt])
}

model SmsDelivery {
  id               String   @id @default(cuid())
  shop             String
  checkoutId       String
  customerKey      String
  source           String
  status           String   @default("RESERVED")
  idempotencyKey   String   @unique
  attemptSource    String
  attemptPeriodEnd DateTime?
  messageId        String?
  sender           String?
  error            String?
  sentAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shop, customerKey, status])
  @@index([shop, checkoutId, createdAt])
}

enum PromptMode {
  append
  replace
  default_only
}

enum CheckoutStatus {
  OPEN
  ABANDONED
  CONVERTED
  RECOVERED
}

enum CallJobStatus {
  QUEUED
  CALLING
  COMPLETED
  FAILED
  CANCELED
}

enum CouponDiscountType {
  PERCENT
  AMOUNT
}

model BillingCoupon {
  id     String  @id @default(uuid()) @db.Uuid
  code   String  @unique
  active Boolean @default(true)

  type       CouponDiscountType
  percentage Float?

  amountOffEUR             Float?
  durationLimitInIntervals Int?

  appliesToPlans Json?

  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  redemptions BillingCouponRedemption[]
}

model BillingCouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @db.Uuid
  shop           String
  subscriptionId String?
  redeemedAt     DateTime @default(now())

  coupon BillingCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, shop])
  @@index([shop])
  @@index([couponId])
}

model AttemptPurchase {
  id String @id @default(cuid())
  shop String
  shopifyPurchaseId String? @unique
  attempts Int
  amountCents Int
  test Boolean @default(false)
  creditedAt DateTime?
  createdAt DateTime @default(now())
  billing ShopBilling @relation(fields: [shop], references: [shop], onDelete: Cascade)
  @@index([shop, creditedAt])
}

model PrivacyRequest {
  id String @id
  shop String
  topic String
  status String @default("PENDING")
  payload Json?
  report Json?
  error String?
  attempts Int @default(0)
  lockedUntil DateTime?
  expiresAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@index([shop, createdAt])
  @@index([status, createdAt])
}
model PrivacySuppression {
  id String @id @default(cuid())
  shop String
  digest String
  expiresAt DateTime
  @@unique([shop, digest])
}
model SupportInquiry {
  id String @id @default(cuid())
  shop String?
  email String
  message String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  @@index([email, createdAt])
}
